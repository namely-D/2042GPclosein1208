{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: g++.exe build and debug active file", // 配置名称，显示在下拉菜单中
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe", // 要调试的程序，与tasks.json中的输出一致
            "args": [], // 如果你的程序需要命令行参数，可以在这里添加，如 ["arg1", "arg2"]
            "stopAtEntry": false, // 为true时，程序启动后会暂停在main函数入口
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false, // 为true会使用外部控制台，但体验不佳，建议false使用集成终端
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe", // 你的gdb调试器绝对路径
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build active file" // 关键！在启动调试前先执行tasks.json中指定label的任务（即编译）
            // "postDebugTask": "echo Done!" // 调试结束后可执行的任务
        }
    ]
}